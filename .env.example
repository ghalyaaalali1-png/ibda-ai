# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.
# Do NOT prefix secrets with NEXT_PUBLIC_ (that would expose them to the browser).

# Anthropic API key — https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Supabase — Project Settings → Data API (URL) and API Keys (publishable key),
# or the "Connect" button on the project page. Both are public by design;
# Row Level Security protects each user's data. Never add the secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public web address once KHITTA is hosted (e.g. https://khitta.ae), used for
# link previews on WhatsApp, LinkedIn and X. Leave empty when running locally.
NEXT_PUBLIC_SITE_URL=
